{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "140",
  "homepage_url": "https://dennis-otto.github.io/player-switch-for-autodarts/",
  "browser_specific_settings": {
    "gecko": {
      "id": "player-switch-for-autodarts@dennis-otto.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      }
    },
    "toggle-switcher": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "__MSG_commandToggle__"
    }
  },
  "background": {
    "service_worker": "lib/background.js",
    "scripts": [
      "lib/background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://play.autodarts.com/*"
      ],
      "js": [
        "lib/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "switcher.html"
      ],
      "matches": [
        "https://play.autodarts.com/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://play.autodarts.com/*",
    "https://api.autodarts.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; img-src 'self' https: data:; connect-src https://api.autodarts.com"
  }
}
