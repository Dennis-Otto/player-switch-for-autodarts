{
  "name": "player-switch-for-autodarts",
  "version": "0.2.0",
  "description": "A Chrome extension that switches between Autodarts accounts on a shared touch display with one tap, without signing in again.",
  "homepage": "https://github.com/Dennis-Otto/player-switch-for-autodarts#readme",
  "bugs": {
    "url": "https://github.com/Dennis-Otto/player-switch-for-autodarts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dennis-Otto/player-switch-for-autodarts.git"
  },
  "license": "MIT",
  "author": "Dennis Otto",
  "type": "module",
  "private": true,
  "files": [
    "extension"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-include=\"scripts/store-status.ts\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.0.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2"
  }
}
