// Renovate for this repository: the rules of the blueprint in
// .github/renovate-blueprint.json5, then those of the project alone below, which
// override them, such as a package that must wait or two that move together:
// https://docs.renovatebot.com/configuration-options/
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>Dennis-Otto/player-switch-for-autodarts//.github/renovate-blueprint.json5"],
  packageRules: [
    {
      // The Playwright image of scripts/screenshots.sh and the playwright of
      // test/harness/requirements.txt, which drives the browser of that image, move
      // together in one pull request, so that the driver never meets another browser;
      // @playwright/test of the end-to-end tests and playwright-core of the
      // accessibility test move with them, so that the pictures and the tests see the
      // same version of Chromium, and npm keeps one copy of playwright-core.
      matchPackageNames: ["mcr.microsoft.com/playwright/python", "playwright", "@playwright/test", "playwright-core"],
      groupName: "Playwright",
    },
  ],
}
